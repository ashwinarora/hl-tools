# WalletConnect project ID for the wallet pickers (faucet miner, Multisig Signer).
# https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: the multisig relay (Supabase). Leave both empty and the Multisig
# Signer works with links and files only. `bun run db:start` prints the local
# values ("API URL" and "Publishable key").
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
