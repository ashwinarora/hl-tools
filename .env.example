# WalletConnect project ID for the wallet pickers (faucet miner, Multisig Signer).
# https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: the multisig relay (Supabase). Leave both empty and the Multisig
# Signer works with links and files only. `bun run db:start` prints the local
# values ("API URL" and "Publishable key").
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: the signing network, for vault deposits and withdrawals in the
# Multisig Signer. Those are signed as a code under chain id 1337, and a wallet
# signs one only while it is on a network with that id. The app offers to add
# such a network to the wallet, pointing at this link. `bun run rpc:1337`
# serves it locally (http://localhost:3337/rpc). Leave empty and the vault
# forms are absent.
VITE_CHAIN_1337_RPC_URL=
